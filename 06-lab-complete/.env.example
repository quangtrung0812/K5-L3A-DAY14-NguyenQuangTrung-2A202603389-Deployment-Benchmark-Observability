# Sao chép file này thành .env khi chạy local (không bao giờ commit .env thật)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bảo mật API (thay bằng khóa bí mật riêng trên môi trường thật)
AGENT_API_KEY=change-me-in-production

# Kết nối Redis cho Rate Limiter & Cost Guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn tốc độ và ngân sách LLM
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
